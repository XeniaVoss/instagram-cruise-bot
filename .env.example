# Copy this file to .env (locally) or paste these as "Environment Variables"
# in your hosting provider's dashboard (Render / Railway).

# Any random string you make up yourself -- Meta will send it back to prove it's really them.
VERIFY_TOKEN=pick-any-random-string-here

# From Meta: Page Access Token (long-lived), generated in Graph API Explorer / App Dashboard.
PAGE_ACCESS_TOKEN=

# From Meta: your Instagram Business Account ID (found in App Dashboard -> Instagram -> Settings).
IG_BUSINESS_ACCOUNT_ID=

# Comma-separated trigger words (case-insensitive).
TRIGGER_KEYWORDS=круиз,cruise

# Optional: only react to comments on these specific post/reel media IDs (comma-separated).
# Leave empty to react on ALL your posts.
TARGET_MEDIA_IDS=

# The DM text that gets sent automatically.
AUTO_REPLY_TEXT=Hi! I booked my cruise through this tour: https://www.trip.com/t/t2cj7oymqV2 The cruise I personally took was called Wonderful Pearl Cruise. But honestly, all the cruise ships are pretty similar, so you can just choose whichever one you like best from the options there
